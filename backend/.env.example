# ==========================================
# Multimodal AI Chatbot Environment Config
# ==========================================

# Application Settings
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection
# For PostgreSQL with pgvector:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mm_chatbot
# For local dev without Postgres, the app automatically falls back to sqlite:///./dev_fallback.db

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# AI LLM Provider Configuration
# Supported options: 'openai', 'gemini', or 'mock'
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (alternative provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Vector Embeddings Provider
# Supported options: 'openai', 'gemini', or 'mock'
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Web Search Provider
# Supported options: 'tavily', 'duckduckgo', or 'mock'
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your_tavily_api_key_here

# RAG Hyperparameters
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35
