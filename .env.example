# ========================================================
# Aura AI Platform — Production Environment Configuration
# ========================================================

# Project & Server
PROJECT_NAME="Aura AI"
DEBUG=false
API_V1_STR=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80

# Database (PostgreSQL 16 with pgvector)
# Set to PostgreSQL in production. If unavailable, application safely falls back to local SQLite.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/mm_chatbot

# Authentication & JWT Security (Change JWT_SECRET to a random 64-char string in production!)
JWT_SECRET=replace-with-ultra-secure-random-64-character-jwt-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Primary Generative AI Provider (gemini or openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback AI Provider (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Vector Embeddings
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072

# Web Search Provider (duckduckgo or tavily)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your_tavily_api_key_here

# RAG & Chunking Tuning
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35

# Upload Security & Storage
MAX_UPLOAD_SIZE_MB=25

